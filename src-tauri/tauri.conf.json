{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "J-Link WinUSB Switcher",
  "version": "1.0.0",
  "identifier": "com.winusbswitcher.lite",
  "build": {
    "frontendDist": "../out/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build && node scripts/stage-jlink-runtime-for-bundle.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "J-Link WinUSB Switcher",
        "width": 780,
        "height": 600,
        "minWidth": 500,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://asset.localhost http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/_bundle_manifest.txt",
      "resources/segger-99-jlink.rules",
      "resources/jlink-runtime-bundled/**/*"
    ]
  }
}